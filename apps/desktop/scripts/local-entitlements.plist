<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for DSH_LOCAL_SIGNING=1 builds: a self-signed identity carries no Apple
     TeamIdentifier, so library validation would reject every cross-binary load; keep JIT
     permission for the interpreters that need it. -->
<plist version="1.0"><dict><key>com.apple.security.cs.allow-jit</key><true/><key>com.apple.security.cs.disable-library-validation</key><true/></dict></plist>
